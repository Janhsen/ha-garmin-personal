  "services": {
    "fetch": {
      "name": "Fetch data",
      "description": "Fetch any Garmin endpoint for a day or range and return the raw result.",
      "fields": {
        "config_entry_id": {
          "name": "Account",
          "description": "Only needed with several accounts."
        },
        "endpoint": {
          "name": "Endpoint",
          "description": "Short name of the endpoint."
        },
        "date": {
          "name": "Date",
          "description": "For single-day endpoints (default today)."
        },
        "start_date": {
          "name": "Start date",
          "description": "For range endpoints."
        },
        "end_date": {
          "name": "End date",
          "description": "For range endpoints."
        },
        "activity_id": {
          "name": "Activity ID",
          "description": "For activity endpoints."
        },
        "filters": {
          "name": "Filters",
          "description": "Activity filters, e.g. activity_type."
        },
        "limit": {
          "name": "Limit",
          "description": "Maximum number of activities."
        }
      }
    },
    "search_activities": {
      "name": "Search activities",
      "description": "Search activities with filters; pages automatically.",
      "fields": {
        "config_entry_id": {
          "name": "Account",
          "description": "Only needed with several accounts."
        },
        "filters": {
          "name": "Filters",
          "description": "For example activity_type, min_distance, start_date."
        },
        "limit": {
          "name": "Limit",
          "description": "Maximum number of activities."
        }
      }
    },
    "download_activity": {
      "name": "Download activity file",
      "description": "Saves the original activity files (ZIP) to disk.",
      "fields": {
        "config_entry_id": {
          "name": "Account",
          "description": "Only needed with several accounts."
        },
        "activity_id": {
          "name": "Activity ID",
          "description": "ID of the activity."
        },
        "path": {
          "name": "Target file",
          "description": "Default: garmin_personal folder in the config directory."
        }
      }
    },
    "backfill_statistics": {
      "name": "Import daily values as statistics",
      "description": "Writes daily values (activity, sleep, HRV, weight) into long-term statistics (external, one value per day). Safe to repeat.",
      "fields": {
        "config_entry_id": {
          "name": "Account",
          "description": "Only needed with several accounts."
        },
        "start_date": {
          "name": "Start date",
          "description": "Default: days back from the end date."
        },
        "end_date": {
          "name": "End date",
          "description": "Default: today."
        },
        "days": {
          "name": "Days",
          "description": "Used when no start date is given."
        },
        "include_third_party_steps": {
          "name": "Steps from other apps",
          "description": "Also import steps, distance and floors of days that other apps (e.g. RunGap) wrote into Garmin Connect. Calories and heart rate of those days are never imported."
        }
      }
    }
  },
  "exceptions": {}
}
