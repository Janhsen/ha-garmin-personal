{
  "config": {
    "step": {
      "user": {
        "title": "Garmin Connect Personal API",
        "description": "Create a key at connect.garmin.com/app/settings/personalApiToken and paste it here. Garmin shows it only once.",
        "data": {
          "name": "Name",
          "api_key": "API key",
          "key_validity_days": "Validity chosen for the key (days)"
        },
        "data_description": {
          "name": "Name of this account in Home Assistant, for example the person's first name.",
          "api_key": "The key from Garmin Connect. It is stored only in Home Assistant.",
          "key_validity_days": "The validity you chose at Garmin when creating the key. Garmin does not reveal the expiry date, so the integration calculates it from this value; it is an estimate and only used for the reminder."
        }
      },
      "reauth_confirm": {
        "title": "New API key",
        "description": "The key for {account} no longer works. Create a new one and enter it.",
        "data": {
          "api_key": "API key",
          "key_validity_days": "Validity (days)"
        },
        "data_description": {
          "key_validity_days": "The validity you chose at Garmin for the new key. The expiry date is calculated from it (estimate)."
        }
      },
      "reconfigure": {
        "title": "Replace API key",
        "description": "Enter a new key for {account}.",
        "data": {
          "api_key": "API key",
          "key_validity_days": "Validity (days)"
