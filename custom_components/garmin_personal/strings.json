        "title": "New API key",
        "description": "The key for {account} no longer works. Create a new one and enter it.",
        "data": {
          "api_key": "API key",
          "key_validity_days": "Validity (days)"
        }
      },
      "reconfigure": {
        "title": "Replace API key",
        "description": "Enter a new key for {account}.",
        "data": {
          "api_key": "API key",
          "key_validity_days": "Validity (days)"
        }
      }
    },
    "error": {
      "invalid_auth": "The key was rejected by Garmin.",
      "cannot_connect": "Could not reach Garmin.",
      "unknown": "Unexpected error, see the log."
